    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b8c09091-5693-494b-90ee-f6d75724d87c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
